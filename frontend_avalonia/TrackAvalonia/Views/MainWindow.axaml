<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TrackAvalonia.Views.MainWindow"
        Width="1240" Height="820"
        Title="Path tracking PI (C# / Avalonia)">

    <Grid ColumnDefinitions="360,*" Margin="6">

        <!-- ============== LEFT: parameter panel ==============
             CLAUDE.md item 1: NO HeaderedContentControl —
             use TextBlock + Border + StackPanel. -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,6,0">
            <StackPanel Spacing="6">

                <!-- ===== Plant ===== -->
                <TextBlock Text="Plant" FontWeight="Bold" Margin="2,0,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="m" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.005" Minimum="0.001" Maximum="100"
                                           FormatString="0.0000"
                                           Value="{Binding M, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="izz" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.01" Minimum="0.001" Maximum="100"
                                           FormatString="0.0000"
                                           Value="{Binding Izz, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="cornering_power" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.5" Minimum="0" Maximum="1000"
                                           FormatString="0.000"
                                           Value="{Binding CorneringPower, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Sampling ===== -->
                <TextBlock Text="Sampling" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="h [s]" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.00001" Minimum="0.000001" Maximum="0.1"
                                           FormatString="0.000000"
                                           Value="{Binding H, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="tc [s]" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.0001" Minimum="0.000001" Maximum="1"
                                           FormatString="0.000000"
                                           Value="{Binding Tc, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="total_time [s]" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="0.01" Maximum="100"
                                           FormatString="0.0000"
                                           Value="{Binding TotalTime, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="target_speed" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="0" Maximum="50"
                                           FormatString="0.0000"
                                           Value="{Binding TargetSpeed, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Gains ===== -->
                <TextBlock Text="Gains" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="ky_p" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="5" Minimum="0" Maximum="5000"
                                           FormatString="0.00"
                                           Value="{Binding KyP, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="ky_i" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.5" Minimum="0" Maximum="5000"
                                           FormatString="0.00"
                                           Value="{Binding KyI, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="kpsi_p" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="5" Minimum="0" Maximum="5000"
                                           FormatString="0.00"
                                           Value="{Binding KpsiP, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="kpsi_i" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.5" Minimum="0" Maximum="5000"
                                           FormatString="0.00"
                                           Value="{Binding KpsiI, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="kr_damping" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="1" Minimum="0" Maximum="1000"
                                           FormatString="0.00"
                                           Value="{Binding KrDamping, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Limits ===== -->
                <TextBlock Text="Limits" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="n_moment_limit" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="10" Minimum="1" Maximum="100000"
                                           FormatString="0.00"
                                           Value="{Binding NMomentLimit, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="fx_limit" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.5" Minimum="0.01" Maximum="1000"
                                           FormatString="0.00"
                                           Value="{Binding FxLimit, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="error_integral_limit" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="0" Maximum="100"
                                           FormatString="0.0000"
                                           Value="{Binding ErrorIntegralLimit, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="lookahead_index" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="1" Minimum="0" Maximum="1000"
                                           FormatString="0"
                                           Value="{Binding LookaheadIndex, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Scenario ===== -->
                <TextBlock Text="Scenario" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="initial_y_offset" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.005" Minimum="-1" Maximum="1"
                                           FormatString="0.0000"
                                           Value="{Binding InitialYOffset, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="initial_heading_deg" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.1" Minimum="-90" Maximum="90"
                                           FormatString="0.000"
                                           Value="{Binding InitialHeadingDeg, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="straight1_len" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.01" Minimum="0" Maximum="10"
                                           FormatString="0.0000"
                                           Value="{Binding Straight1Len, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="radius" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.01" Minimum="0.01" Maximum="10"
                                           FormatString="0.0000"
                                           Value="{Binding Radius, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="straight2_len" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.01" Minimum="0" Maximum="10"
                                           FormatString="0.0000"
                                           Value="{Binding Straight2Len, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="130,*">
                            <TextBlock Grid.Column="0" Text="ds" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.0001" Minimum="0.0001" Maximum="1"
                                           FormatString="0.00000"
                                           Value="{Binding Ds, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button Content="Run"            Width="100" Click="OnRunClick"/>
                    <Button Content="Reset defaults" Width="140" Click="OnResetClick"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ============== RIGHT: plots + metrics ============== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">

            <!-- ===== XY plot =====
                 CLAUDE.md item 2: Line + StartPoint/EndPoint for grid;
                 Rectangle for the plot box. -->
            <TextBlock Grid.Row="0" Text="Path tracking — XY (equal aspect)"
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
            <Border Grid.Row="1" BorderBrush="#888" BorderThickness="1"
                    Background="White" CornerRadius="2">
                <Canvas Width="540" Height="380">

                    <!-- Grid lines (Line elements, per CLAUDE.md item 2) -->
                    <ItemsControl ItemsSource="{Binding GridLines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line Stroke="#E0E0E0" StrokeThickness="1"
                                      StartPoint="{Binding Start}"
                                      EndPoint  ="{Binding End}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Plot box -->
                    <Rectangle Stroke="Black" StrokeThickness="1" Fill="Transparent"
                               Width="{Binding XyBoxWidth}"
                               Height="{Binding XyBoxHeight}"
                               Canvas.Left="{Binding XyBoxLeft}"
                               Canvas.Top ="{Binding XyBoxTop}"/>

                    <!-- Reference path (blue dashed) -->
                    <Polyline Stroke="#1F77B4" StrokeThickness="1.4"
                              StrokeDashArray="6,4"
                              Points="{Binding ReferencePoints}"/>

                    <!-- Actual path (orange) -->
                    <Polyline Stroke="#FF7F0E" StrokeThickness="1.6"
                              Points="{Binding ActualPoints}"/>

                    <!-- Y-axis tick labels (CLAUDE.md item 3) -->
                    <TextBlock Canvas.Left="4" Canvas.Top="22"  FontSize="9" Text="{Binding RefY100}"/>
                    <TextBlock Canvas.Left="4" Canvas.Top="108" FontSize="9" Text="{Binding RefY75}"/>
                    <TextBlock Canvas.Left="4" Canvas.Top="194" FontSize="9" Text="{Binding RefY50}"/>
                    <TextBlock Canvas.Left="4" Canvas.Top="280" FontSize="9" Text="{Binding RefY25}"/>
                    <TextBlock Canvas.Left="4" Canvas.Top="338" FontSize="9" Text="{Binding RefY0}"/>

                    <!-- X-axis tick labels -->
                    <TextBlock Canvas.Left="26"  Canvas.Top="352" FontSize="9" Text="{Binding RefX0}"/>
                    <TextBlock Canvas.Left="146" Canvas.Top="352" FontSize="9" Text="{Binding RefX25}"/>
                    <TextBlock Canvas.Left="266" Canvas.Top="352" FontSize="9" Text="{Binding RefX50}"/>
                    <TextBlock Canvas.Left="386" Canvas.Top="352" FontSize="9" Text="{Binding RefX75}"/>
                    <TextBlock Canvas.Left="496" Canvas.Top="352" FontSize="9" Text="{Binding RefX100}"/>

                    <!-- Axis labels -->
                    <TextBlock Canvas.Left="260" Canvas.Top="362" FontSize="10" Text="X [m]"/>

                    <!-- Start / End markers -->
                    <Ellipse Width="8" Height="8" Fill="#1F77B4"
                             Stroke="Black" StrokeThickness="0.6"
                             Canvas.Left="{Binding StartMarkerX}"
                             Canvas.Top ="{Binding StartMarkerY}"/>
                    <Ellipse Width="8" Height="8" Fill="#FF7F0E"
                             Stroke="Black" StrokeThickness="0.6"
                             Canvas.Left="{Binding EndMarkerX}"
                             Canvas.Top ="{Binding EndMarkerY}"/>

                    <!-- Legend -->
                    <Border Canvas.Left="38" Canvas.Top="40"
                            Background="#EEFFFFFF" BorderBrush="#BBB" BorderThickness="1" Padding="4">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Line Stroke="#1F77B4" StrokeThickness="2"
                                      StrokeDashArray="3,2"
                                      StartPoint="0,0" EndPoint="18,0"
                                      VerticalAlignment="Center" Width="18"/>
                                <TextBlock Text="Reference path" FontSize="9"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Line Stroke="#FF7F0E" StrokeThickness="2"
                                      StartPoint="0,0" EndPoint="18,0"
                                      VerticalAlignment="Center" Width="18"/>
                                <TextBlock Text="Actual path" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Border>

            <!-- ===== Path-error time series ===== -->
            <TextBlock Grid.Row="2" Text="Path error over time"
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,2"/>
            <Border Grid.Row="2" Margin="0,24,0,0"
                    BorderBrush="#888" BorderThickness="1"
                    Background="White" CornerRadius="2">
                <Canvas Width="540" Height="200">
                    <ItemsControl ItemsSource="{Binding ErrGridLines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line Stroke="#E0E0E0" StrokeThickness="1"
                                      StartPoint="{Binding Start}"
                                      EndPoint  ="{Binding End}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Rectangle Stroke="Black" StrokeThickness="1" Fill="Transparent"
                               Width="{Binding ErrBoxWidth}"
                               Height="{Binding ErrBoxHeight}"
                               Canvas.Left="{Binding ErrBoxLeft}"
                               Canvas.Top ="{Binding ErrBoxTop}"/>
                    <Polyline Stroke="#1F77B4" StrokeThickness="1.6"
                              Points="{Binding ErrorPoints}"/>
                    <TextBlock Canvas.Left="4" Canvas.Top="14"  FontSize="9" Text="{Binding ErrY100}"/>
                    <TextBlock Canvas.Left="4" Canvas.Top="98"  FontSize="9" Text="{Binding ErrY50}"/>
                    <TextBlock Canvas.Left="4" Canvas.Top="172" FontSize="9" Text="{Binding ErrY0}"/>
                    <TextBlock Canvas.Left="28"  Canvas.Top="180" FontSize="9" Text="{Binding ErrX0}"/>
                    <TextBlock Canvas.Left="266" Canvas.Top="180" FontSize="9" Text="{Binding ErrX50}"/>
                    <TextBlock Canvas.Left="496" Canvas.Top="180" FontSize="9" Text="{Binding ErrX100}"/>
                    <TextBlock Canvas.Left="240" Canvas.Top="186" FontSize="10" Text="Time [s]"/>
                </Canvas>
            </Border>

            <!-- ===== Metrics ===== -->
            <Grid Grid.Row="3" Margin="0,8,0,0" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Metrics" FontWeight="Bold" Margin="2,0,0,2"/>
                <Border Grid.Row="1" BorderBrush="#888" BorderThickness="1"
                        Background="#F8F8F8" CornerRadius="2" Padding="6">
                    <Grid RowDefinitions="*,Auto">
                        <TextBox Grid.Row="0" Text="{Binding MetricsText}"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas, Menlo, monospace" FontSize="11"
                                 BorderThickness="0" Background="Transparent"/>
                        <TextBlock Grid.Row="1" Margin="0,4,0,0"
                                   FontFamily="Consolas, Menlo, monospace" FontSize="11"
                                   Text="{Binding StatusMessage}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
