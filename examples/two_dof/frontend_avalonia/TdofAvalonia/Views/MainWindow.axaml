<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TdofAvalonia.Views.MainWindow"
        Width="1320" Height="720"
        Title="2-DOF control comparison (C# / Avalonia)">

    <Grid ColumnDefinitions="300,*,360" Margin="6">

        <!-- ============== LEFT: parameters ============== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4" Spacing="8">

                <!-- Plant group -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Plant  P(s)=1/(m s²+c s+k)"
                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <Border BorderBrush="#AAAAAA" BorderThickness="1"
                            CornerRadius="3" Padding="8,6,8,8">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,120">
                                <TextBlock Grid.Column="0" Text="m"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Increment="0.005" Minimum="0.0001" Maximum="100"
                                               FormatString="0.0000"
                                               Value="{Binding M, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,120">
                                <TextBlock Grid.Column="0" Text="c"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Increment="0.005" Minimum="0" Maximum="100"
                                               FormatString="0.0000"
                                               Value="{Binding C, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,120">
                                <TextBlock Grid.Column="0" Text="k"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Increment="0.1" Minimum="0" Maximum="100"
                                               FormatString="0.0000"
                                               Value="{Binding K, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PID gains group -->
                <StackPanel Spacing="4">
                    <TextBlock Text="PID gains"
                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <Border BorderBrush="#AAAAAA" BorderThickness="1"
                            CornerRadius="3" Padding="8,6,8,8">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,120">
                                <TextBlock Grid.Column="0" Text="kp"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Increment="0.1" Minimum="0" Maximum="1000"
                                               FormatString="0.0000"
                                               Value="{Binding Kp, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,120">
                                <TextBlock Grid.Column="0" Text="ki"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Increment="0.5" Minimum="0" Maximum="1000"
                                               FormatString="0.0000"
                                               Value="{Binding Ki, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,120">
                                <TextBlock Grid.Column="0" Text="kd"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Increment="0.01" Minimum="0" Maximum="1000"
                                               FormatString="0.0000"
                                               Value="{Binding Kd, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Scenario group -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Scenario"
                               FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <Border BorderBrush="#AAAAAA" BorderThickness="1"
                            CornerRadius="3" Padding="8,6,8,8">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,120">
                                <TextBlock Grid.Column="0" Text="ref"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Increment="0.5" Minimum="-1000" Maximum="1000"
                                               FormatString="0.0000"
                                               Value="{Binding Ref, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,120">
                                <TextBlock Grid.Column="0" Text="t_end"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Increment="0.5" Minimum="0.1" Maximum="100"
                                               FormatString="0.0000"
                                               Value="{Binding TEnd, Mode=TwoWay}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,120">
                                <TextBlock Grid.Column="0" Text="dt"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1"
                                               Increment="0.005" Minimum="0.0001" Maximum="1"
                                               FormatString="0.0000"
                                               Value="{Binding Dt, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Run"            Width="120" Click="OnRunClick"/>
                    <Button Content="Reset defaults" Width="140" Click="OnResetClick"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ============== CENTRE: plots ============== -->
        <!--
            Canvas coordinate system (shared by both plots):
              MarginL=50  MarginR=14  MarginT=16  MarginB=28
              plotW=396   plotH=206
              Grid lines at X = 50,149,248,347,446  Y = 16,67.5,119,170.5,222
        -->
        <StackPanel Grid.Column="1" Margin="6" Spacing="8">

            <!-- Reference signal comparison -->
            <StackPanel Spacing="2">
                <TextBlock Text="Reference Signal Comparison" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <Border BorderBrush="#888" BorderThickness="1"
                        Background="White" CornerRadius="2">
                    <Canvas Width="460" Height="250">

                        <!-- Grid lines -->
                        <Line StartPoint="50,16"    EndPoint="446,16"    Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="50,67.5"  EndPoint="446,67.5"  Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="50,119"   EndPoint="446,119"   Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="50,170.5" EndPoint="446,170.5" Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="50,222"   EndPoint="446,222"   Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="50,16"    EndPoint="50,222"    Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="149,16"   EndPoint="149,222"   Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="248,16"   EndPoint="248,222"   Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="347,16"   EndPoint="347,222"   Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="446,16"   EndPoint="446,222"   Stroke="#E6E6E6" StrokeThickness="1"/>

                        <!-- Plot border box -->
                        <Rectangle Canvas.Left="50" Canvas.Top="16"
                                   Width="396" Height="206"
                                   Stroke="Black" StrokeThickness="1" Fill="Transparent"/>

                        <!-- Y axis tick labels (right-aligned near left margin) -->
                        <TextBlock Canvas.Left="2" Canvas.Top="10"  FontSize="9" Text="{Binding RefYTop}"/>
                        <TextBlock Canvas.Left="2" Canvas.Top="60"  FontSize="9" Text="{Binding RefY25}"/>
                        <TextBlock Canvas.Left="2" Canvas.Top="111" FontSize="9" Text="{Binding RefY50}"/>
                        <TextBlock Canvas.Left="2" Canvas.Top="162" FontSize="9" Text="{Binding RefY75}"/>
                        <TextBlock Canvas.Left="2" Canvas.Top="210" FontSize="9" Text="{Binding RefYBot}"/>

                        <!-- X axis tick labels -->
                        <TextBlock Canvas.Left="46"  Canvas.Top="227" FontSize="9" Text="0"/>
                        <TextBlock Canvas.Left="142" Canvas.Top="227" FontSize="9" Text="{Binding RefX25}"/>
                        <TextBlock Canvas.Left="241" Canvas.Top="227" FontSize="9" Text="{Binding RefX50}"/>
                        <TextBlock Canvas.Left="340" Canvas.Top="227" FontSize="9" Text="{Binding RefX75}"/>
                        <TextBlock Canvas.Left="438" Canvas.Top="227" FontSize="9" Text="{Binding RefXEnd}"/>

                        <!-- Data polylines -->
                        <Polyline Stroke="#1F77B4" StrokeThickness="1.8"
                                  Points="{Binding RefOriginalPoints}"/>
                        <Polyline Stroke="#FF7F0E" StrokeThickness="1.8"
                                  Points="{Binding RefFilteredPoints}"/>

                        <!-- Legend -->
                        <Border Canvas.Left="300" Canvas.Top="12" Background="#EEFFFFFF"
                                BorderBrush="#BBB" BorderThickness="1" Padding="4">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Rectangle Width="16" Height="3" Fill="#1F77B4"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Original Reference" FontSize="9"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Rectangle Width="16" Height="3" Fill="#FF7F0E"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Filtered Reference" FontSize="9"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Border>
                <TextBlock Text="Time [s]" FontSize="9" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Output response comparison -->
            <StackPanel Spacing="2">
                <TextBlock Text="Output Response Comparison" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <Border BorderBrush="#888" BorderThickness="1"
                        Background="White" CornerRadius="2">
                    <Canvas Width="460" Height="250">

                        <!-- Grid lines -->
                        <Line StartPoint="50,16"    EndPoint="446,16"    Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="50,67.5"  EndPoint="446,67.5"  Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="50,119"   EndPoint="446,119"   Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="50,170.5" EndPoint="446,170.5" Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="50,222"   EndPoint="446,222"   Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="50,16"    EndPoint="50,222"    Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="149,16"   EndPoint="149,222"   Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="248,16"   EndPoint="248,222"   Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="347,16"   EndPoint="347,222"   Stroke="#E6E6E6" StrokeThickness="1"/>
                        <Line StartPoint="446,16"   EndPoint="446,222"   Stroke="#E6E6E6" StrokeThickness="1"/>

                        <!-- Plot border box -->
                        <Rectangle Canvas.Left="50" Canvas.Top="16"
                                   Width="396" Height="206"
                                   Stroke="Black" StrokeThickness="1" Fill="Transparent"/>

                        <!-- Y axis tick labels -->
                        <TextBlock Canvas.Left="2" Canvas.Top="10"  FontSize="9" Text="{Binding OutYTop}"/>
                        <TextBlock Canvas.Left="2" Canvas.Top="60"  FontSize="9" Text="{Binding OutY25}"/>
                        <TextBlock Canvas.Left="2" Canvas.Top="111" FontSize="9" Text="{Binding OutY50}"/>
                        <TextBlock Canvas.Left="2" Canvas.Top="162" FontSize="9" Text="{Binding OutY75}"/>
                        <TextBlock Canvas.Left="2" Canvas.Top="210" FontSize="9" Text="{Binding OutYBot}"/>

                        <!-- X axis tick labels -->
                        <TextBlock Canvas.Left="46"  Canvas.Top="227" FontSize="9" Text="0"/>
                        <TextBlock Canvas.Left="142" Canvas.Top="227" FontSize="9" Text="{Binding OutX25}"/>
                        <TextBlock Canvas.Left="241" Canvas.Top="227" FontSize="9" Text="{Binding OutX50}"/>
                        <TextBlock Canvas.Left="340" Canvas.Top="227" FontSize="9" Text="{Binding OutX75}"/>
                        <TextBlock Canvas.Left="438" Canvas.Top="227" FontSize="9" Text="{Binding OutXEnd}"/>

                        <!-- Data polylines -->
                        <Polyline Stroke="#1F77B4" StrokeThickness="1.8"
                                  Points="{Binding OutPidPoints}"/>
                        <Polyline Stroke="#FF7F0E" StrokeThickness="1.8"
                                  Points="{Binding Out2DofPoints}"/>

                        <!-- Legend -->
                        <Border Canvas.Left="350" Canvas.Top="12" Background="#EEFFFFFF"
                                BorderBrush="#BBB" BorderThickness="1" Padding="4">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Rectangle Width="16" Height="3" Fill="#1F77B4"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="PID" FontSize="9"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Rectangle Width="16" Height="3" Fill="#FF7F0E"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="2DOF-like" FontSize="9"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Border>
                <TextBlock Text="Time [s]" FontSize="9" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- ============== RIGHT: TF + log ============== -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*" Margin="6">
            <TextBlock Grid.Row="0" Text="Transfer functions" FontWeight="Bold"/>
            <Border Grid.Row="1" BorderBrush="#888" BorderThickness="1"
                    Background="#F8F8F8" CornerRadius="2" Margin="0,2,0,8"
                    Padding="6" MaxHeight="260">
                <TextBox Text="{Binding TfText}" IsReadOnly="True"
                         AcceptsReturn="True" FontFamily="Consolas, Menlo, monospace"
                         FontSize="11" BorderThickness="0" Background="Transparent"/>
            </Border>
            <TextBlock Grid.Row="2" Text="Metrics" FontWeight="Bold"/>
            <Border Grid.Row="3" BorderBrush="#888" BorderThickness="1"
                    Background="#F8F8F8" CornerRadius="2" Margin="0,2,0,0"
                    Padding="6">
                <TextBox Text="{Binding LogText}" IsReadOnly="True"
                         AcceptsReturn="True" FontFamily="Consolas, Menlo, monospace"
                         FontSize="11" BorderThickness="0" Background="Transparent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
