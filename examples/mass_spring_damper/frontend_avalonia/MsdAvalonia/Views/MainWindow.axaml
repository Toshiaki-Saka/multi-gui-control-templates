<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MsdAvalonia.Views.MainWindow"
        Width="1320" Height="800"
        Title="MSD forced response (C# / Avalonia)">

    <Grid ColumnDefinitions="240,340,*" Margin="6">

        <!-- ============== LEFT: case list ==============
             CLAUDE.md item 1: NO HeaderedContentControl —
             use TextBlock + Border + StackPanel. -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,6,0">
            <TextBlock Grid.Row="0" Text="Cases" FontWeight="Bold" Margin="2,0,0,4"/>
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                <ListBox Name="CaseListBox"
                         ItemsSource="{Binding Cases}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <UniformGrid Grid.Row="2" Columns="2" Margin="0,6,0,0">
                <Button Content="Add"        Click="OnAddClick"       Margin="0,0,2,2"/>
                <Button Content="Duplicate"  Click="OnDuplicateClick" Margin="2,0,0,2"/>
                <Button Content="Remove"     Click="OnRemoveClick"    Margin="0,2,2,0"/>
                <Button Content="Reset"      Click="OnResetClick"     Margin="2,2,0,0"/>
            </UniformGrid>
        </Grid>

        <!-- ============== MIDDLE: case editor ============== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Margin="0,0,6,0">
            <StackPanel Spacing="6">

                <TextBlock Text="Name" FontWeight="Bold" Margin="2,0,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <TextBox Text="{Binding EditorName, Mode=TwoWay}"/>
                </Border>

                <!-- ===== Plant ===== -->
                <TextBlock Text="Plant" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="m [kg]" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="0.0001" Maximum="1000"
                                           FormatString="0.0000"
                                           Value="{Binding EditorM, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="c [N·s/m]" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="0" Maximum="1000"
                                           FormatString="0.0000"
                                           Value="{Binding EditorC, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="k [N/m]" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.1" Minimum="0" Maximum="1000000"
                                           FormatString="0.0000"
                                           Value="{Binding EditorK, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== External force ===== -->
                <TextBlock Text="External force  f(t) = F·sin(ω·t)" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="F" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="-1000" Maximum="1000"
                                           FormatString="0.0000"
                                           Value="{Binding EditorF, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="ω" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.05" Minimum="0" Maximum="1000"
                                           FormatString="0.0000"
                                           Value="{Binding EditorW, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Initial state ===== -->
                <TextBlock Text="Initial state" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="x0" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.01" Minimum="-100" Maximum="100"
                                           FormatString="0.0000"
                                           Value="{Binding EditorX0, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="v0" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1" Increment="0.01" Minimum="-100" Maximum="100"
                                           FormatString="0.0000"
                                           Value="{Binding EditorV0, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Derived ===== -->
                <TextBlock Text="Derived" FontWeight="Bold" Margin="2,4,0,0"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6" CornerRadius="2">
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="ωn [rad/s]"/>
                            <TextBlock Grid.Column="1" Text="{Binding OmegaNText}"
                                       FontFamily="Consolas, Menlo, monospace"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="ζ"/>
                            <TextBlock Grid.Column="1" Text="{Binding ZetaText}"
                                       FontFamily="Consolas, Menlo, monospace"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="x(final) [m]"/>
                            <TextBlock Grid.Column="1" Text="{Binding FinalXText}"
                                       FontFamily="Consolas, Menlo, monospace"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="v(final) [m/s]"/>
                            <TextBlock Grid.Column="1" Text="{Binding FinalVText}"
                                       FontFamily="Consolas, Menlo, monospace"/>
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="max |x| [m]"/>
                            <TextBlock Grid.Column="1" Text="{Binding MaxAbsXText}"
                                       FontFamily="Consolas, Menlo, monospace"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============== RIGHT: overlay plot ============== -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto">

            <TextBlock Grid.Row="0"
                       Text="Mass-Spring-Damper Forced Response — Parameter Sweep"
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>

            <!-- ===== Plot canvas =====
                 CLAUDE.md item 2: Line + StartPoint/EndPoint for grid;
                 Rectangle for plot box. -->
            <Border Grid.Row="1" BorderBrush="#888" BorderThickness="1"
                    Background="White" CornerRadius="2">
                <Canvas Width="700" Height="460">

                    <!-- Grid lines -->
                    <ItemsControl ItemsSource="{Binding GridLines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas Width="700" Height="460"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line Stroke="#E0E0E0" StrokeThickness="1"
                                      StartPoint="{Binding Start}"
                                      EndPoint  ="{Binding End}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Plot box -->
                    <Rectangle Stroke="Black" StrokeThickness="1" Fill="Transparent"
                               Width="{Binding PlotBoxWidth}"
                               Height="{Binding PlotBoxHeight}"
                               Canvas.Left="{Binding PlotBoxLeft}"
                               Canvas.Top ="{Binding PlotBoxTop}"/>

                    <!-- Series polylines (one per enabled case) -->
                    <ItemsControl ItemsSource="{Binding Series}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas Width="700" Height="460"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Polyline Stroke="{Binding Stroke}" StrokeThickness="1.6"
                                          Points="{Binding Points}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Y-axis tick labels (CLAUDE.md item 3) -->
                    <TextBlock Canvas.Left="6"  Canvas.Top="32"  FontSize="9" Text="{Binding RefY100}"/>
                    <TextBlock Canvas.Left="6"  Canvas.Top="128" FontSize="9" Text="{Binding RefY75}"/>
                    <TextBlock Canvas.Left="6"  Canvas.Top="226" FontSize="9" Text="{Binding RefY50}"/>
                    <TextBlock Canvas.Left="6"  Canvas.Top="324" FontSize="9" Text="{Binding RefY25}"/>
                    <TextBlock Canvas.Left="6"  Canvas.Top="418" FontSize="9" Text="{Binding RefY0}"/>

                    <!-- X-axis tick labels -->
                    <TextBlock Canvas.Left="36"  Canvas.Top="426" FontSize="9" Text="{Binding RefX0}"/>
                    <TextBlock Canvas.Left="190" Canvas.Top="426" FontSize="9" Text="{Binding RefX25}"/>
                    <TextBlock Canvas.Left="344" Canvas.Top="426" FontSize="9" Text="{Binding RefX50}"/>
                    <TextBlock Canvas.Left="498" Canvas.Top="426" FontSize="9" Text="{Binding RefX75}"/>
                    <TextBlock Canvas.Left="650" Canvas.Top="426" FontSize="9" Text="{Binding RefX100}"/>

                    <!-- Axis labels -->
                    <TextBlock Canvas.Left="340" Canvas.Top="442" FontSize="10" Text="t [s]"/>
                    <TextBlock Canvas.Left="6"   Canvas.Top="6"   FontSize="10" Text="x [m]"/>

                    <!-- Legend (multi-line text, top-left of plot area) -->
                    <Border Canvas.Left="50" Canvas.Top="46"
                            Background="#EEFFFFFF" BorderBrush="#BBB" BorderThickness="1"
                            Padding="6">
                        <TextBlock Text="{Binding LegendText}" FontSize="9"
                                   FontFamily="Consolas, Menlo, monospace"/>
                    </Border>
                </Canvas>
            </Border>

            <!-- ===== Sampling + actions ===== -->
            <Grid Grid.Row="2" Margin="0,6,0,0"
                  ColumnDefinitions="Auto,120,Auto,120,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="dt [s]" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <NumericUpDown Grid.Column="1" Increment="0.0005" Minimum="0.000001" Maximum="1"
                               FormatString="0.000000"
                               Value="{Binding Dt, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="stop [s]" VerticalAlignment="Center" Margin="10,0,4,0"/>
                <NumericUpDown Grid.Column="3" Increment="0.5" Minimum="0.1" Maximum="1000"
                               FormatString="0.000"
                               Value="{Binding Stop, Mode=TwoWay}"/>
                <TextBlock Grid.Column="4" Text="" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="" />
                <Button Grid.Column="6" Content="Run" Click="OnRunClick" Width="80"/>
            </Grid>

            <!-- ===== Status ===== -->
            <Border Grid.Row="3" BorderBrush="#888" BorderThickness="1"
                    Background="#F8F8F8" CornerRadius="2" Padding="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="Consolas, Menlo, monospace" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</Window>
